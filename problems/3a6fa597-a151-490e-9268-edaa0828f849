// Turns an export from the Maths Workshop editor (JSON) into problem files.
// Usage: npm run import -- path/to/export.json
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const ROOT = path.dirname(fileURLToPath(import.meta.url));
const input = process.argv[2];
if (!input) { console.error('Usage: npm run import -- path/to/export.json'); process.exit(1); }

let data;
try { data = JSON.parse(fs.readFileSync(input, 'utf8')); } catch (e) { console.error('Could not read that file as JSON.'); process.exit(1); }
if (!Array.isArray(data)) { console.error('The file must contain a list of problems.'); process.exit(1); }

const slugify = s => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'problem';
const dir = path.join(ROOT, 'problems');
let made = 0, skipped = 0;
for (const p of data) {
  if (!p || typeof p.title !== 'string' || typeof p.statement !== 'string') { skipped++; continue; }
  if (p.example) { skipped++; continue; } // built-in examples are already in problems/
  let slug = slugify(p.title), name = slug, n = 2;
  while (fs.existsSync(path.join(dir, name + '.md'))) name = `${slug}-${n++}`;
  const date = p.created ? new Date(+p.created).toISOString().slice(0, 10) : new Date().toISOString().slice(0, 10);
  const out = `---
title: ${p.title.replace(/\n/g, ' ')}
category: ${p.cat || 'algebra'}
level: ${p.level || 'l1'}
difficulty: ${p.diff || 2}
tags: ${(p.tags || []).join(', ')}
date: ${date}
---

## Statement

${p.statement.trim()}

${p.hint ? `## Hint\n\n${p.hint.trim()}\n\n` : ''}${p.solution ? `## Solution\n\n${p.solution.trim()}\n` : ''}`;
  fs.writeFileSync(path.join(dir, name + '.md'), out);
  made++;
}
console.log(`Created ${made} problem file(s) in problems/, skipped ${skipped}. Now run: npm run build`);
